// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pivot step > compiles a group by, a pivot and a filtered pivot > group by 1`] = `
"SELECT "region", sum("total") AS "sum of total", count(DISTINCT "id") AS "count distinct of id" FROM "n_in" GROUP BY "region"
ORDER BY "region" ASC NULLS LAST"
`;

exports[`pivot step > compiles a group by, a pivot and a filtered pivot > pivot 1`] = `
"SELECT "region", "__puddle_p0_v0" AS "2024-01 sum of total", "__puddle_p0_v1" AS "2024-01 list of rep", "__puddle_p1_v0" AS "it's sum of total", "__puddle_p1_v1" AS "it's list of rep" FROM (
  PIVOT (SELECT "region", CAST("month" AS VARCHAR) AS "__puddle_pivot", "total" AS "__puddle_v0", "rep" AS "__puddle_v1", "__puddle_row" FROM (SELECT *, row_number() OVER () AS "__puddle_row" FROM "n_in"))
  ON "__puddle_pivot" IN ('2024-01' AS "__puddle_p0", 'it''s' AS "__puddle_p1")
  USING sum("__puddle_v0") AS "v0", string_agg(CAST("__puddle_v1" AS VARCHAR), ', ' ORDER BY "__puddle_row") AS "v1"
  GROUP BY "region"
)
ORDER BY "region" ASC NULLS LAST"
`;

exports[`pivot step > compiles a group by, a pivot and a filtered pivot > pivot with filters and no rows 1`] = `
"SELECT "__puddle_p0_v0" AS "2024-01 sum of total" FROM (
  PIVOT (SELECT CAST("month" AS VARCHAR) AS "__puddle_pivot", "total" AS "__puddle_v0" FROM (SELECT * FROM "n_in" WHERE coalesce((lower(CAST("region" AS VARCHAR)) = 'north'), false)))
  ON "__puddle_pivot" IN ('2024-01' AS "__puddle_p0")
  USING sum("__puddle_v0") AS "v0"
)"
`;

exports[`transpose step > compiles to UNPIVOT then PIVOT over the rows it was set up for, stopping if their number changes > with headers 1`] = `
"SELECT "__puddle_c" AS "column", "__puddle_r1_v" AS "East", "__puddle_r2_v" AS "it's" FROM (
  PIVOT (SELECT "__puddle_r", "__puddle_c", "__puddle_v" FROM (SELECT row_number() OVER () AS "__puddle_r", CAST("q1" AS VARCHAR) AS "q1" FROM "n_in" WHERE (SELECT CASE WHEN count(*) <> 2 THEN error('Puddle: Transpose was set up for 2 rows, and its input has a different number now. Refresh the rows in the step’s settings.') ELSE true END FROM "n_in")) UNPIVOT INCLUDE NULLS ("__puddle_v" FOR "__puddle_c" IN ("q1")))
  ON "__puddle_r" IN (1 AS "__puddle_r1", 2 AS "__puddle_r2")
  USING first("__puddle_v") AS "v"
  GROUP BY "__puddle_c"
)
ORDER BY list_position(['q1'], "__puddle_c")"
`;

exports[`unpivot step > compiles to UNPIVOT, keeping empty values and casting to text only when asked > columns 1`] = `"SELECT * FROM "n_in" UNPIVOT ("value" FOR "attribute" IN ("q1", "q2"))"`;

exports[`unpivot step > compiles to UNPIVOT, keeping empty values and casting to text only when asked > every column except, as text, with empty values 1`] = `"SELECT * FROM (SELECT "region", CAST(COLUMNS(* EXCLUDE ("region")) AS VARCHAR) FROM "n_in") UNPIVOT INCLUDE NULLS ("sales" FOR "quarter" IN (COLUMNS(* EXCLUDE ("region"))))"`;
