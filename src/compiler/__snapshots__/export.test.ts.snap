// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`compileExport > {"format":"clipboard","options":{}} 1`] = `
"COPY (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv'))
SELECT * FROM "n_src") TO 'o''ut.file' (FORMAT csv, HEADER true, DELIMITER '	')"
`;

exports[`compileExport > {"format":"csv","options":{"delimiter":"\\t","header":false}} 1`] = `
"COPY (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv'))
SELECT * FROM "n_src") TO 'o''ut.file' (FORMAT csv, HEADER false, DELIMITER '	')"
`;

exports[`compileExport > {"format":"csv","options":{}} 1`] = `
"COPY (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv'))
SELECT * FROM "n_src") TO 'o''ut.file' (FORMAT csv, HEADER true, DELIMITER ',')"
`;

exports[`compileExport > {"format":"json","options":{}} 1`] = `
"COPY (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv'))
SELECT * FROM "n_src") TO 'o''ut.file' (FORMAT json, ARRAY true)"
`;

exports[`compileExport > {"format":"ndjson","options":{}} 1`] = `
"COPY (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv'))
SELECT * FROM "n_src") TO 'o''ut.file' (FORMAT json)"
`;

exports[`compileExport > {"format":"parquet","options":{"compression":"snappy"}} 1`] = `
"COPY (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv'))
SELECT * FROM "n_src") TO 'o''ut.file' (FORMAT parquet, COMPRESSION snappy)"
`;
