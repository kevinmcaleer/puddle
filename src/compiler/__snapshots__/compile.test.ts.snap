exports[`step snapshots > standardise {"columns":["id"],"method":"minmax"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s0" AS (SELECT * REPLACE (CASE WHEN "id" IS NULL THEN NULL WHEN (max("id") OVER () - min("id") OVER ()) = 0 THEN 0.0 ELSE ("id" - min("id") OVER ()) / (max("id") OVER () - min("id") OVER ()) END AS "id") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > standardise {"columns":["id"],"method":"zscore"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s0" AS (SELECT * REPLACE (CASE WHEN "id" IS NULL THEN NULL WHEN stddev_pop("id") OVER () = 0 THEN 0.0 ELSE ("id" - avg("id") OVER ()) / stddev_pop("id") OVER () END AS "id") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

