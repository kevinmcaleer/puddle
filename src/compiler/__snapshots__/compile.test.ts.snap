  "n_clean_s0" AS (SELECT * EXCLUDE ("__puddle_row", "__puddle_key") FROM (SELECT row_number() OVER () AS "__puddle_row", row(*COLUMNS(*)) AS "__puddle_key", * FROM "n_src") QUALIFY row_number() OVER (PARTITION BY "__puddle_key" ORDER BY "__puddle_row") = 1 ORDER BY "__puddle_row")
SELECT * FROM "n_clean_s0""
`;

