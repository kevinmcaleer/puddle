// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`compile > compiles a source node 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv'))
SELECT * FROM "n_src""
`;

exports[`compile > compiles a transform node as one CTE per step 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1""
`;

exports[`compile > compiles a transform with no steps (a Check node) as a pass-through 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv'))
SELECT * FROM "n_src""
`;

exports[`compile > leaves disabled steps out of the SQL 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s1" AS (SELECT * EXCLUDE ("email") FROM "n_src")
SELECT * FROM "n_clean_s1""
`;

exports[`compile > quotes awkward column and node names 1`] = `
"WITH "n_n""1" AS (SELECT * FROM read_csv('src_a"b.csv')),
  "n_t_s0" AS (SELECT * RENAME ("first ""name""" AS "it's") FROM "n_n""1")
SELECT * FROM "n_t_s0""
`;

exports[`results table queries > profiles through SUMMARIZE 1`] = `
"SELECT column_name, CAST(null_percentage AS DOUBLE) AS null_pct, approx_unique FROM (SUMMARIZE SELECT * FROM (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1"))"
`;

exports[`sources > csv with {"delimiter":";","header":true,"quote":"\\"","encoding":"latin-1","nullStrings":["N/A",""]} 1`] = `"read_csv('src_x.csv', delim = ';', header = true, quote = '"', encoding = 'latin-1', nullstr = ['N/A', ''])"`;

exports[`sources > csv with {} 1`] = `"read_csv('src_x.csv')"`;

exports[`sources > json with {} 1`] = `"read_json_auto('src_x.json')"`;

exports[`sources > ndjson with {} 1`] = `"read_json_auto('src_x.ndjson', format = 'newline_delimited')"`;

exports[`sources > parquet with {} 1`] = `"read_parquet('src_x.parquet')"`;

exports[`sources > tsv with {} 1`] = `"read_csv('src_x.tsv', delim = '	')"`;

exports[`sources > xlsx with {} 1`] = `""src_x""`;

exports[`step snapshots > addColumn {"name":"domain","expression":"split_part(email, '@', 2)"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT *, (split_part(email, '@', 2)) AS "domain" FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > addIndex {"name":"row","start":0} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT row_number() OVER () - 1 AS "row", * FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > addIndex {"name":"row","start":1} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT row_number() OVER () AS "row", * FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > changeCase {"columns":["name"],"mode":"lower"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (lower("name") AS "name") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > changeCase {"columns":["name"],"mode":"sentence"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (upper(left("name", 1)) || lower(substr("name", 2)) AS "name") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > changeCase {"columns":["name"],"mode":"title"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > changeCase {"columns":["name"],"mode":"upper"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (upper("name") AS "name") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > changeType {"columns":["id"],"to":"text","onError":"empty"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (TRY_CAST("id" AS VARCHAR) AS "id") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > changeType {"columns":["joined","id"],"to":"date","onError":"fail"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (CAST("joined" AS DATE) AS "joined", CAST("id" AS DATE) AS "id") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > duplicateColumn {"column":"email","into":"email copy"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT *, "email" AS "email copy" FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > duplicateRows {"columns":["email"],"keep":"duplicates"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * EXCLUDE ("__puddle_row", "__puddle_key") FROM (SELECT row_number() OVER () AS "__puddle_row", row("email") AS "__puddle_key", * FROM "n_src") QUALIFY count(*) OVER (PARTITION BY "__puddle_key") > 1 ORDER BY "__puddle_row")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > duplicateRows {"columns":[],"keep":"first"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * EXCLUDE ("__puddle_row", "__puddle_key") FROM (SELECT row_number() OVER () AS "__puddle_row", row(*COLUMNS(*)) AS "__puddle_key", * FROM "n_src") QUALIFY row_number() OVER (PARTITION BY "__puddle_key" ORDER BY "__puddle_row") = 1 ORDER BY "__puddle_row")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > fillRows {"columns":["name","email"],"direction":"up"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * EXCLUDE ("__puddle_row") REPLACE (first_value("name" IGNORE NULLS) OVER (ORDER BY "__puddle_row" ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS "name", first_value("email" IGNORE NULLS) OVER (ORDER BY "__puddle_row" ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS "email") FROM (SELECT row_number() OVER () AS "__puddle_row", * FROM "n_src") ORDER BY "__puddle_row")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > fillRows {"columns":["name"],"direction":"down"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * EXCLUDE ("__puddle_row") REPLACE (last_value("name" IGNORE NULLS) OVER (ORDER BY "__puddle_row" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "name") FROM (SELECT row_number() OVER () AS "__puddle_row", * FROM "n_src") ORDER BY "__puddle_row")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > filterRows {"mode":"keep","match":"all","conditions":[{"column":"email","op":"contains","value":"O'Brien"}],"matchCase":false} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * FROM "n_src" WHERE coalesce((contains(lower(CAST("email" AS VARCHAR)), 'o''brien')), false))
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > filterRows {"mode":"remove","match":"any","conditions":[{"column":"id","op":"greater","value":"2"},{"column":"name","op":"empty","value":""}],"matchCase":true} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * FROM "n_src" WHERE NOT coalesce(("id" > '2') OR (coalesce(trim(CAST("name" AS VARCHAR)), '') = ''), false))
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > mergeColumns {"columns":["name","email"],"separator":" <","into":"contact","keepOriginals":false} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * EXCLUDE ("name", "email"), concat_ws(' <', CAST("name" AS VARCHAR), CAST("email" AS VARCHAR)) AS "contact" FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > promoteHeaders {"renames":[{"from":"id","to":"ID"},{"from":"name","to":"name"}]} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * RENAME ("id" AS "ID") FROM "n_src" OFFSET 1)
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > removeBlankRows {"columns":["name","email"]} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * FROM "n_src" WHERE coalesce(trim(concat_ws('', CAST("name" AS VARCHAR), CAST("email" AS VARCHAR))), '') <> '')
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > removeBlankRows {"columns":[]} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * FROM "n_src" WHERE coalesce(trim(concat_ws('', *COLUMNS(*))), '') <> '')
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > removeColumns {"columns":["email"]} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * EXCLUDE ("email") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > removeRows {"from":"bottom","count":1} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * FROM "n_src" LIMIT greatest((SELECT count(*) FROM "n_src") - 1, 0))
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > removeRows {"from":"top","count":2} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * FROM "n_src" OFFSET 2)
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > renameColumns {"renames":[{"from":"name","to":"full_name"},{"from":"joined","to":"joined_on"}]} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * RENAME ("name" AS "full_name", "joined" AS "joined_on") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > reorderColumns {"columns":["email","id"]} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT "email", "id", * EXCLUDE ("email", "id") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > sortRows {"keys":[{"column":"joined","descending":true},{"column":"id","descending":false}]} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * EXCLUDE ("__puddle_row") FROM (SELECT row_number() OVER () AS "__puddle_row", * FROM "n_src") ORDER BY "joined" DESC NULLS LAST, "id" ASC NULLS LAST, "__puddle_row")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > splitByDelimiter {"column":"email","delimiter":"@","into":["user","domain"],"keepOriginal":false} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * EXCLUDE ("email"), string_split(CAST("email" AS VARCHAR), '@')[1] AS "user", string_split(CAST("email" AS VARCHAR), '@')[2] AS "domain" FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > splitByDelimiter {"column":"name","delimiter":"'","into":["a"],"keepOriginal":true} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT *, string_split(CAST("name" AS VARCHAR), '''')[1] AS "a" FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > splitByPosition {"column":"joined","positions":[4,7],"into":["year","dash_month","dash_day"],"keepOriginal":true} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT *, substr(CAST("joined" AS VARCHAR), 1, 4) AS "year", substr(CAST("joined" AS VARCHAR), 5, 3) AS "dash_month", substr(CAST("joined" AS VARCHAR), 8) AS "dash_day" FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > trimWhitespace {"columns":["name","email"]} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name", trim("email") AS "email") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;
