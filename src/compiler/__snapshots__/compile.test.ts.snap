SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > changeType {"columns":["joined","id"],"to":"date","onError":"fail"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (CAST("joined" AS DATE) AS "joined", CAST("id" AS DATE) AS "id") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > collapseSpaces {"columns":["name","email"]} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (regexp_replace(CAST("name" AS VARCHAR), '\\s{2,}', ' ', 'g') AS "name", regexp_replace(CAST("email" AS VARCHAR), '\\s{2,}', ' ', 'g') AS "email") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > duplicateColumn {"column":"email","into":"email copy"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT *, "email" AS "email copy" FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > duplicateRows {"columns":["email"],"keep":"duplicates"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * EXCLUDE ("__puddle_row", "__puddle_key") FROM (SELECT row_number() OVER () AS "__puddle_row", row("email") AS "__puddle_key", * FROM "n_src") QUALIFY count(*) OVER (PARTITION BY "__puddle_key") > 1 ORDER BY "__puddle_row")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > duplicateRows {"columns":[],"keep":"first"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * EXCLUDE ("__puddle_row", "__puddle_key") FROM (SELECT row_number() OVER () AS "__puddle_row", row(*COLUMNS(*)) AS "__puddle_key", * FROM "n_src") QUALIFY row_number() OVER (PARTITION BY "__puddle_key" ORDER BY "__puddle_row") = 1 ORDER BY "__puddle_row")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > emptyToNull {"columns":["name","id"]} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (CASE WHEN trim(CAST("name" AS VARCHAR)) = '' THEN NULL ELSE "name" END AS "name", CASE WHEN trim(CAST("id" AS VARCHAR)) = '' THEN NULL ELSE "id" END AS "id") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > extractText {"column":"email","mode":"between","start":"@","end":".","into":"host"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT *, nullif(regexp_extract(CAST("email" AS VARCHAR), '@(.*?)\\.', 1), '') AS "host" FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > extractText {"column":"email","mode":"prefix","length":3,"into":"start"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT *, left(CAST("email" AS VARCHAR), 3) AS "start" FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > extractText {"column":"email","mode":"suffix","length":4,"into":"tld"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT *, right(CAST("email" AS VARCHAR), 4) AS "tld" FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > extractText {"column":"joined","mode":"regex","pattern":"^([0-9]{4})","group":1,"into":"year"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT *, nullif(regexp_extract(CAST("joined" AS VARCHAR), '^([0-9]{4})', 1), '') AS "year" FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > fillRows {"columns":["name","email"],"direction":"up"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * EXCLUDE ("__puddle_row") REPLACE (first_value("name" IGNORE NULLS) OVER (ORDER BY "__puddle_row" ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS "name", first_value("email" IGNORE NULLS) OVER (ORDER BY "__puddle_row" ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS "email") FROM (SELECT row_number() OVER () AS "__puddle_row", * FROM "n_src") ORDER BY "__puddle_row")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > fillRows {"columns":["name"],"direction":"down"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * EXCLUDE ("__puddle_row") REPLACE (last_value("name" IGNORE NULLS) OVER (ORDER BY "__puddle_row" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "name") FROM (SELECT row_number() OVER () AS "__puddle_row", * FROM "n_src") ORDER BY "__puddle_row")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > filterRows {"mode":"keep","match":"all","conditions":[{"column":"email","op":"contains","value":"O'Brien"}],"matchCase":false} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * FROM "n_src" WHERE coalesce((contains(lower(CAST("email" AS VARCHAR)), 'o''brien')), false))
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > filterRows {"mode":"remove","match":"any","conditions":[{"column":"id","op":"greater","value":"2"},{"column":"name","op":"empty","value":""}],"matchCase":true} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * FROM "n_src" WHERE NOT coalesce(("id" > '2') OR (coalesce(trim(CAST("name" AS VARCHAR)), '') = ''), false))
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > findReplace {"columns":["email"],"find":"A.B","replace":"x\\\\1","regex":false,"matchCase":false} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (regexp_replace(CAST("email" AS VARCHAR), 'A\\.B', 'x\\\\1', 'gi') AS "email") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > findReplace {"columns":["email"],"find":"example.com","replace":"o'brien.org","regex":false,"matchCase":true} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (replace(CAST("email" AS VARCHAR), 'example.com', 'o''brien.org') AS "email") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > findReplace {"columns":["name","email"],"find":"\\\\s+","replace":" ","regex":true,"matchCase":true} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (regexp_replace(CAST("name" AS VARCHAR), '\\s+', ' ', 'g') AS "name", regexp_replace(CAST("email" AS VARCHAR), '\\s+', ' ', 'g') AS "email") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > mergeColumns {"columns":["name","email"],"separator":" <","into":"contact","keepOriginals":false} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * EXCLUDE ("name", "email"), concat_ws(' <', CAST("name" AS VARCHAR), CAST("email" AS VARCHAR)) AS "contact" FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > padText {"columns":["id"],"length":5,"character":"0","side":"start"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (CASE WHEN length(CAST("id" AS VARCHAR)) >= 5 THEN CAST("id" AS VARCHAR) ELSE lpad(CAST("id" AS VARCHAR), 5, '0') END AS "id") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > padText {"columns":["name"],"length":20,"character":".","side":"end"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (CASE WHEN length(CAST("name" AS VARCHAR)) >= 20 THEN CAST("name" AS VARCHAR) ELSE rpad(CAST("name" AS VARCHAR), 20, '.') END AS "name") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > parseDates {"columns":["joined"],"formats":["%Y-%m-%d %H:%M:%S","%d %b '%y"],"onError":"fail"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (CAST(strptime(trim(CAST("joined" AS VARCHAR)), ['%Y-%m-%d %H:%M:%S', '%d %b ''%y']) AS TIMESTAMP) AS "joined") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > parseDates {"columns":["joined"],"formats":["%d/%m/%Y"],"onError":"empty"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (CAST(try_strptime(trim(CAST("joined" AS VARCHAR)), '%d/%m/%Y') AS DATE) AS "joined") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > parseNumbers {"columns":["id"],"decimal":","} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (CASE WHEN regexp_matches(trim(CAST("id" AS VARCHAR)), '^\\(.*\\)$') THEN -TRY_CAST(replace(regexp_replace(CAST("id" AS VARCHAR), '[^0-9,\\-]', '', 'g'), ',', '.') AS DOUBLE) ELSE TRY_CAST(replace(regexp_replace(CAST("id" AS VARCHAR), '[^0-9,\\-]', '', 'g'), ',', '.') AS DOUBLE) END AS "id") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > parseNumbers {"columns":["id"],"decimal":"."} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (CASE WHEN regexp_matches(trim(CAST("id" AS VARCHAR)), '^\\(.*\\)$') THEN -TRY_CAST(regexp_replace(CAST("id" AS VARCHAR), '[^0-9.\\-]', '', 'g') AS DOUBLE) ELSE TRY_CAST(regexp_replace(CAST("id" AS VARCHAR), '[^0-9.\\-]', '', 'g') AS DOUBLE) END AS "id") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

