"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (CASE WHEN "id" IS NULL THEN NULL WHEN (max("id") OVER () - min("id") OVER ()) = 0 THEN 0.0 ELSE ("id" - min("id") OVER ()) / (max("id") OVER () - min("id") OVER ()) END AS "id") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

