exports[`step snapshots > bucketNumbers {"column":"id","mode":"edges","edges":[18,65],"into":"o'clock"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s0" AS (SELECT *, CASE WHEN "id" IS NULL THEN NULL WHEN "id" < 18 THEN 'under 18' WHEN "id" < 65 THEN '18 to under 65' ELSE '65 and over' END AS "o'clock" FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > bucketNumbers {"column":"id","mode":"width","width":0.5,"start":-1,"edges":[],"into":"band"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s0" AS (SELECT *, CAST(CAST(round(-1 + (floor(round(("id" - -1) / 0.5, 9))) * 0.5, 1) AS DECIMAL(38, 1)) AS VARCHAR) || ' to under ' || CAST(CAST(round(-1 + (floor(round(("id" - -1) / 0.5, 9)) + 1) * 0.5, 1) AS DECIMAL(38, 1)) AS VARCHAR) AS "band" FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

