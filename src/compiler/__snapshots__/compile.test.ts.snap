  "n_clean_s0" AS (SELECT "email", "id", * EXCLUDE ("email", "id") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > replaceValues {"columns":["id"],"match":"blank","replace":"n/a","toText":true} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s0" AS (SELECT * REPLACE (CASE WHEN "id" IS NULL OR trim(CAST("id" AS VARCHAR)) = '' THEN 'n/a' ELSE CAST("id" AS VARCHAR) END AS "id") FROM "n_src")
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > replaceValues {"columns":["id"],"match":"value","find":"0","replaceWithNull":true} 1`] = `
