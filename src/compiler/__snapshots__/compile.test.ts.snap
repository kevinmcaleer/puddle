  "n_clean_s0" AS (SELECT * REPLACE (CASE WHEN "name" IS NULL THEN 'empty' ELSE "name" END AS "name", CASE WHEN "email" IS NULL THEN 'empty' ELSE "email" END AS "email") FROM "n_src")
