exports[`step snapshots > splitByTransition {"column":"name","transition":"lowerUpper","into":["a","b"]} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s0" AS (SELECT * EXCLUDE ("name", "__puddle_split"), "__puddle_split"[1] AS "a", "__puddle_split"[2] AS "b" FROM (SELECT * REPLACE ("__puddle_split" AS "__puddle_split") FROM (SELECT *, string_split(regexp_replace(CAST("name" AS VARCHAR), '([a-z])([A-Z])', '\\1' || chr(31) || '\\2', 'g'), chr(31)) AS "__puddle_split" FROM "n_src")))
SELECT * FROM "n_clean_s0""
`;

exports[`step snapshots > splitByTransition {"column":"name","transition":"nonDigitDigit","to":"rows"} 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s0" AS (SELECT * EXCLUDE ("__puddle_split") REPLACE (unnest(CASE WHEN coalesce(len("__puddle_split"), 0) = 0 THEN [NULL::VARCHAR] ELSE "__puddle_split" END) AS "name") FROM (SELECT * REPLACE ("__puddle_split" AS "__puddle_split") FROM (SELECT *, string_split(regexp_replace(CAST("name" AS VARCHAR), '([^0-9])([0-9])', '\\1' || chr(31) || '\\2', 'g'), chr(31)) AS "__puddle_split" FROM "n_src")))
SELECT * FROM "n_clean_s0""
