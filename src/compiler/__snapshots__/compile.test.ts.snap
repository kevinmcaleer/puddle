// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`column step settings > detects date formats on a sample of non-empty values: which formats read each distinct value 1`] = `
"WITH s AS (SELECT raw, regexp_replace(regexp_replace(regexp_replace(raw, '([0-9])(?:st|nd|rd|th)\\b(?:\\s+of\\b)?', '\\1', 'gi'), '\\bsept\\b', 'Sep', 'gi'), '\\b(jan|feb|mar|apr|jun|jul|aug|sep|oct|nov|dec)\\.', '\\1', 'gi') AS v, row_number() OVER () AS i FROM (SELECT trim(CAST("joined" AS VARCHAR)) AS raw FROM (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1") WHERE coalesce(trim(CAST("joined" AS VARCHAR)), '') <> '' LIMIT 1000))
SELECT raw AS value, count(*) AS n, concat_ws(',', CASE WHEN CASE WHEN year(try_strptime(v, '%Y-%m-%d')) >= 1000 THEN try_strptime(v, '%Y-%m-%d') END IS NOT NULL THEN '0' END, CASE WHEN CASE WHEN year(try_strptime(v, '%d/%m/%Y')) >= 1000 THEN try_strptime(v, '%d/%m/%Y') END IS NOT NULL THEN '1' END) AS reads FROM s GROUP BY raw, v ORDER BY min(i)"
`;

exports[`compile > compiles a source node 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true))
SELECT * FROM "n_src""
`;

exports[`compile > compiles a transform node as one CTE per step 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1""
`;

exports[`compile > compiles a transform with no steps (a Check node) as a pass-through 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true))
SELECT * FROM "n_src""
`;

exports[`compile > leaves disabled steps out of the SQL 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s1" AS (SELECT * EXCLUDE ("email") FROM "n_src")
SELECT * FROM "n_clean_s1""
`;

exports[`compile > quotes awkward column and node names 1`] = `
"WITH "n_n""1" AS (SELECT * FROM read_csv('src_a"b.csv', null_padding = true)),
  "n_t_s0" AS (SELECT * RENAME ("first ""name""" AS "it's") FROM "n_n""1")
SELECT * FROM "n_t_s0""
`;

exports[`quality rules > counts every rule’s failures over the node’s output in one query 1`] = `
"SELECT count(*) AS total, count(*) FILTER (WHERE NOT coalesce("r0", false)) AS "f0", count(*) FILTER (WHERE NOT coalesce("r1", false)) AS "f1" FROM (SELECT (NOT (coalesce(trim(CAST("email" AS VARCHAR)), '') = '')) AS "r0", (("id" IS NULL) OR count(*) OVER (PARTITION BY "id") = 1) AS "r1" FROM (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1"))"
`;

exports[`quality rules > inRange {"column":"id","min":"1","max":"10"} 1`] = `""id" IS NULL OR ("id" >= '1' AND "id" <= '10')"`;

exports[`quality rules > inRange {"column":"joined","min":"2020-01-01","max":""} 1`] = `""joined" IS NULL OR ("joined" >= '2020-01-01')"`;

exports[`quality rules > inSet {"column":"name","values":["Ann","O'Neil"],"matchCase":true} 1`] = `""name" IS NULL OR CAST("name" AS VARCHAR) IN ('Ann', 'O''Neil')"`;

exports[`quality rules > inSet {"column":"name","values":["Ann"],"matchCase":false} 1`] = `""name" IS NULL OR lower(CAST("name" AS VARCHAR)) IN ('ann')"`;

exports[`quality rules > matchesPattern {"column":"email","preset":"email"} 1`] = `""email" IS NULL OR regexp_full_match(CAST("email" AS VARCHAR), '^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')"`;

exports[`quality rules > matchesPattern {"column":"id","preset":"custom","pattern":"^[0-9]+'$"} 1`] = `""id" IS NULL OR regexp_full_match(CAST("id" AS VARCHAR), '^[0-9]+''$')"`;

exports[`quality rules > noEdgeSpaces {"column":"name"} 1`] = `""name" IS NULL OR CAST("name" AS VARCHAR) = trim(CAST("name" AS VARCHAR))"`;

exports[`quality rules > notEmpty {"column":"email"} 1`] = `"NOT (coalesce(trim(CAST("email" AS VARCHAR)), '') = '')"`;

exports[`quality rules > readsAs {"column":"joined","as":"date"} 1`] = `"coalesce(trim(CAST("joined" AS VARCHAR)), '') = '' OR (TRY_CAST(trim(CAST("joined" AS VARCHAR)) AS DATE) IS NOT NULL)"`;

exports[`quality rules > readsAs {"column":"na\\"me","as":"number"} 1`] = `"coalesce(trim(CAST("na""me" AS VARCHAR)), '') = '' OR ((TRY_CAST(trim(CAST("na""me" AS VARCHAR)) AS DOUBLE) IS NOT NULL OR regexp_matches(trim(CAST("na""me" AS VARCHAR)), '^\\(?\\s*-?\\s*[£$€¥]?\\s*-?(\\d{1,3}([,. ]\\d{3})*|\\d+)([.,]\\d+)?\\s*%?\\s*([£$€¥]|[A-Z]{3})?\\s*\\)?-?$')))"`;

exports[`quality rules > shows only the rows a rule fails, keyed apart from the full preview 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0"),
  "n_clean_failing" AS (SELECT * EXCLUDE ("__puddle_pass") FROM (SELECT *, (NOT (coalesce(trim(CAST("email" AS VARCHAR)), '') = '')) AS "__puddle_pass" FROM "n_clean_s1") WHERE NOT coalesce("__puddle_pass", false))
SELECT * FROM "n_clean_failing""
`;

exports[`quality rules > unique {"columns":["id"]} 1`] = `"("id" IS NULL) OR count(*) OVER (PARTITION BY "id") = 1"`;

exports[`quality rules > unique {"columns":["name","email"]} 1`] = `"("name" IS NULL OR "email" IS NULL) OR count(*) OVER (PARTITION BY "name", "email") = 1"`;

exports[`results table queries > checks what text columns look like, one set of counts per column 1`] = `
"SELECT count(*) FILTER (WHERE nullif(trim(CAST("joined" AS VARCHAR)), '') IS NOT NULL AND NOT lower(nullif(trim(CAST("joined" AS VARCHAR)), '')) IN ('n/a', 'na', 'n.a.', 'n.a', '#n/a', 'n/a.', 'not available', 'not applicable', '-', '--', '---', '?', '??', '.', '...', 'null', 'nil', 'none', 'nan', 'unknown', 'missing', 'tbd', 'tbc', '(blank)', '(empty)', '(null)', '(none)', '#null!', '#value!', '#ref!', '#div/0!', '#name?') AND lower(nullif(trim(CAST("joined" AS VARCHAR)), '')) <> 'joined') AS "n0", count(*) FILTER (WHERE nullif(trim(CAST("joined" AS VARCHAR)), '') IS NOT NULL AND NOT lower(nullif(trim(CAST("joined" AS VARCHAR)), '')) IN ('n/a', 'na', 'n.a.', 'n.a', '#n/a', 'n/a.', 'not available', 'not applicable', '-', '--', '---', '?', '??', '.', '...', 'null', 'nil', 'none', 'nan', 'unknown', 'missing', 'tbd', 'tbc', '(blank)', '(empty)', '(null)', '(none)', '#null!', '#value!', '#ref!', '#div/0!', '#name?') AND lower(nullif(trim(CAST("joined" AS VARCHAR)), '')) <> 'joined' AND (TRY_CAST(nullif(trim(CAST("joined" AS VARCHAR)), '') AS DOUBLE) IS NOT NULL OR regexp_matches(nullif(trim(CAST("joined" AS VARCHAR)), ''), '^\\(?\\s*-?\\s*[£$€¥]?\\s*-?(\\d{1,3}([,. ]\\d{3})*|\\d+)([.,]\\d+)?\\s*%?\\s*([£$€¥]|[A-Z]{3})?\\s*\\)?-?$'))) AS "num0", count(*) FILTER (WHERE nullif(trim(CAST("joined" AS VARCHAR)), '') IS NOT NULL AND NOT lower(nullif(trim(CAST("joined" AS VARCHAR)), '')) IN ('n/a', 'na', 'n.a.', 'n.a', '#n/a', 'n/a.', 'not available', 'not applicable', '-', '--', '---', '?', '??', '.', '...', 'null', 'nil', 'none', 'nan', 'unknown', 'missing', 'tbd', 'tbc', '(blank)', '(empty)', '(null)', '(none)', '#null!', '#value!', '#ref!', '#div/0!', '#name?') AND lower(nullif(trim(CAST("joined" AS VARCHAR)), '')) <> 'joined' AND (TRY_CAST(nullif(trim(CAST("joined" AS VARCHAR)), '') AS DATE) IS NOT NULL OR regexp_matches(nullif(trim(CAST("joined" AS VARCHAR)), ''), '^(\\d{1,2}[/.-]\\d{1,2}[/.-]\\d{2,4}|\\d{4}[/.-]\\d{1,2}[/.-]\\d{1,2}|\\d{1,2}(st|nd|rd|th)?\\.?\\s+(of\\s+)?[a-z]{3,9}\\.?,?\\s+\\d{4}|[a-z]{3,9}\\.?\\s+\\d{1,2}(st|nd|rd|th)?,?\\s+\\d{4}|\\d{4}[01]\\d[0-3]\\d)([ t]\\d{1,2}:\\d{2}(:\\d{2}(\\.\\d+)?)?\\s*([ap]m)?\\s*(z|[+-]\\d{2}:?\\d{2}|utc|gmt)?)?$', 'i'))) AS "date0", count(*) FILTER (WHERE nullif(trim(CAST("na""me" AS VARCHAR)), '') IS NOT NULL AND NOT lower(nullif(trim(CAST("na""me" AS VARCHAR)), '')) IN ('n/a', 'na', 'n.a.', 'n.a', '#n/a', 'n/a.', 'not available', 'not applicable', '-', '--', '---', '?', '??', '.', '...', 'null', 'nil', 'none', 'nan', 'unknown', 'missing', 'tbd', 'tbc', '(blank)', '(empty)', '(null)', '(none)', '#null!', '#value!', '#ref!', '#div/0!', '#name?') AND lower(nullif(trim(CAST("na""me" AS VARCHAR)), '')) <> 'na"me') AS "n1", count(*) FILTER (WHERE nullif(trim(CAST("na""me" AS VARCHAR)), '') IS NOT NULL AND NOT lower(nullif(trim(CAST("na""me" AS VARCHAR)), '')) IN ('n/a', 'na', 'n.a.', 'n.a', '#n/a', 'n/a.', 'not available', 'not applicable', '-', '--', '---', '?', '??', '.', '...', 'null', 'nil', 'none', 'nan', 'unknown', 'missing', 'tbd', 'tbc', '(blank)', '(empty)', '(null)', '(none)', '#null!', '#value!', '#ref!', '#div/0!', '#name?') AND lower(nullif(trim(CAST("na""me" AS VARCHAR)), '')) <> 'na"me' AND (TRY_CAST(nullif(trim(CAST("na""me" AS VARCHAR)), '') AS DOUBLE) IS NOT NULL OR regexp_matches(nullif(trim(CAST("na""me" AS VARCHAR)), ''), '^\\(?\\s*-?\\s*[£$€¥]?\\s*-?(\\d{1,3}([,. ]\\d{3})*|\\d+)([.,]\\d+)?\\s*%?\\s*([£$€¥]|[A-Z]{3})?\\s*\\)?-?$'))) AS "num1", count(*) FILTER (WHERE nullif(trim(CAST("na""me" AS VARCHAR)), '') IS NOT NULL AND NOT lower(nullif(trim(CAST("na""me" AS VARCHAR)), '')) IN ('n/a', 'na', 'n.a.', 'n.a', '#n/a', 'n/a.', 'not available', 'not applicable', '-', '--', '---', '?', '??', '.', '...', 'null', 'nil', 'none', 'nan', 'unknown', 'missing', 'tbd', 'tbc', '(blank)', '(empty)', '(null)', '(none)', '#null!', '#value!', '#ref!', '#div/0!', '#name?') AND lower(nullif(trim(CAST("na""me" AS VARCHAR)), '')) <> 'na"me' AND (TRY_CAST(nullif(trim(CAST("na""me" AS VARCHAR)), '') AS DATE) IS NOT NULL OR regexp_matches(nullif(trim(CAST("na""me" AS VARCHAR)), ''), '^(\\d{1,2}[/.-]\\d{1,2}[/.-]\\d{2,4}|\\d{4}[/.-]\\d{1,2}[/.-]\\d{1,2}|\\d{1,2}(st|nd|rd|th)?\\.?\\s+(of\\s+)?[a-z]{3,9}\\.?,?\\s+\\d{4}|[a-z]{3,9}\\.?\\s+\\d{1,2}(st|nd|rd|th)?,?\\s+\\d{4}|\\d{4}[01]\\d[0-3]\\d)([ t]\\d{1,2}:\\d{2}(:\\d{2}(\\.\\d+)?)?\\s*([ap]m)?\\s*(z|[+-]\\d{2}:?\\d{2}|utc|gmt)?)?$', 'i'))) AS "date1" FROM (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1")"
`;

exports[`results table queries > confirms suggested rules with exact counts, only those asked for per column 1`] = `
"SELECT count(*) AS "rows", count("id") AS "nn0", count(*) FILTER (WHERE coalesce(trim(CAST("id" AS VARCHAR)), '') = '') AS "blank0", count(DISTINCT "id") AS "distinct0", count("na""me") AS "nn1", count(*) FILTER (WHERE CAST("na""me" AS VARCHAR) <> trim(CAST("na""me" AS VARCHAR))) AS "edges1", list_sort(list(DISTINCT CAST("na""me" AS VARCHAR)) FILTER (WHERE "na""me" IS NOT NULL)) AS "values1" FROM (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1")"
`;

exports[`results table queries > profiles through SUMMARIZE 1`] = `
"SELECT column_name, CAST(null_percentage AS DOUBLE) AS null_pct, approx_unique, CAST(min AS VARCHAR) AS min, CAST(max AS VARCHAR) AS max FROM (SUMMARIZE SELECT * FROM (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true)),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1"))"
`;

exports[`sample mode > reads only the first rows of a sampled source, and nothing else changes 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv', null_padding = true) LIMIT 1000),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1""
`;

