// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`column step settings > detects date formats on a sample of non-empty values, one constant format per SELECT 1`] = `
"WITH s AS (SELECT trim(CAST("joined" AS VARCHAR)) AS v FROM (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1") WHERE coalesce(trim(CAST("joined" AS VARCHAR)), '') <> '' LIMIT 1000)
SELECT format, matched, total, example FROM (
  SELECT 0 AS i, '%Y-%m-%d' AS format, count(*) FILTER (WHERE try_strptime(v, '%Y-%m-%d') IS NOT NULL) AS matched, count(*) AS total, any_value(v) FILTER (WHERE try_strptime(v, '%Y-%m-%d') IS NOT NULL) AS example FROM s
  UNION ALL SELECT 1 AS i, '%d/%m/%Y' AS format, count(*) FILTER (WHERE try_strptime(v, '%d/%m/%Y') IS NOT NULL) AS matched, count(*) AS total, any_value(v) FILTER (WHERE try_strptime(v, '%d/%m/%Y') IS NOT NULL) AS example FROM s
) ORDER BY i"
`;

exports[`compile > compiles a source node 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv'))
SELECT * FROM "n_src""
`;

exports[`compile > compiles a transform node as one CTE per step 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1""
`;

exports[`compile > compiles a transform with no steps (a Check node) as a pass-through 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv'))
SELECT * FROM "n_src""
`;

exports[`compile > leaves disabled steps out of the SQL 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s1" AS (SELECT * EXCLUDE ("email") FROM "n_src")
SELECT * FROM "n_clean_s1""
`;

exports[`compile > quotes awkward column and node names 1`] = `
"WITH "n_n""1" AS (SELECT * FROM read_csv('src_a"b.csv')),
  "n_t_s0" AS (SELECT * RENAME ("first ""name""" AS "it's") FROM "n_n""1")
SELECT * FROM "n_t_s0""
`;

exports[`quality rules > counts every rule’s failures over the node’s output in one query 1`] = `
"SELECT count(*) AS total, count(*) FILTER (WHERE NOT coalesce("r0", false)) AS "f0", count(*) FILTER (WHERE NOT coalesce("r1", false)) AS "f1" FROM (SELECT (NOT (coalesce(trim(CAST("email" AS VARCHAR)), '') = '')) AS "r0", (("id" IS NULL) OR count(*) OVER (PARTITION BY "id") = 1) AS "r1" FROM (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1"))"
`;

exports[`quality rules > inRange {"column":"id","min":"1","max":"10"} 1`] = `""id" IS NULL OR ("id" >= '1' AND "id" <= '10')"`;

exports[`quality rules > inRange {"column":"joined","min":"2020-01-01","max":""} 1`] = `""joined" IS NULL OR ("joined" >= '2020-01-01')"`;

exports[`quality rules > inSet {"column":"name","values":["Ann","O'Neil"],"matchCase":true} 1`] = `""name" IS NULL OR CAST("name" AS VARCHAR) IN ('Ann', 'O''Neil')"`;

exports[`quality rules > inSet {"column":"name","values":["Ann"],"matchCase":false} 1`] = `""name" IS NULL OR lower(CAST("name" AS VARCHAR)) IN ('ann')"`;

exports[`quality rules > matchesPattern {"column":"email","preset":"email"} 1`] = `""email" IS NULL OR regexp_full_match(CAST("email" AS VARCHAR), '^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')"`;

exports[`quality rules > matchesPattern {"column":"id","preset":"custom","pattern":"^[0-9]+'$"} 1`] = `""id" IS NULL OR regexp_full_match(CAST("id" AS VARCHAR), '^[0-9]+''$')"`;

exports[`quality rules > noEdgeSpaces {"column":"name"} 1`] = `""name" IS NULL OR CAST("name" AS VARCHAR) = trim(CAST("name" AS VARCHAR))"`;

exports[`quality rules > notEmpty {"column":"email"} 1`] = `"NOT (coalesce(trim(CAST("email" AS VARCHAR)), '') = '')"`;

exports[`quality rules > readsAs {"column":"joined","as":"date"} 1`] = `"coalesce(trim(CAST("joined" AS VARCHAR)), '') = '' OR (TRY_CAST(trim(CAST("joined" AS VARCHAR)) AS DATE) IS NOT NULL)"`;

exports[`quality rules > readsAs {"column":"na\\"me","as":"number"} 1`] = `"coalesce(trim(CAST("na""me" AS VARCHAR)), '') = '' OR (TRY_CAST(trim(CAST("na""me" AS VARCHAR)) AS DOUBLE) IS NOT NULL)"`;

exports[`quality rules > shows only the rows a rule fails, keyed apart from the full preview 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0"),
  "n_clean_failing" AS (SELECT * EXCLUDE ("__puddle_pass") FROM (SELECT *, (NOT (coalesce(trim(CAST("email" AS VARCHAR)), '') = '')) AS "__puddle_pass" FROM "n_clean_s1") WHERE NOT coalesce("__puddle_pass", false))
SELECT * FROM "n_clean_failing""
`;

exports[`quality rules > unique {"columns":["id"]} 1`] = `"("id" IS NULL) OR count(*) OVER (PARTITION BY "id") = 1"`;

exports[`quality rules > unique {"columns":["name","email"]} 1`] = `"("name" IS NULL OR "email" IS NULL) OR count(*) OVER (PARTITION BY "name", "email") = 1"`;

exports[`results table queries > checks what text columns look like, one set of counts per column 1`] = `
"SELECT count(nullif(trim(CAST("joined" AS VARCHAR)), '')) AS "n0", count(TRY_CAST(nullif(trim(CAST("joined" AS VARCHAR)), '') AS DOUBLE)) AS "num0", count(TRY_CAST(nullif(trim(CAST("joined" AS VARCHAR)), '') AS DATE)) AS "date0", count(nullif(trim(CAST("na""me" AS VARCHAR)), '')) AS "n1", count(TRY_CAST(nullif(trim(CAST("na""me" AS VARCHAR)), '') AS DOUBLE)) AS "num1", count(TRY_CAST(nullif(trim(CAST("na""me" AS VARCHAR)), '') AS DATE)) AS "date1" FROM (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1")"
`;

exports[`results table queries > confirms suggested rules with exact counts, only those asked for per column 1`] = `
"SELECT count(*) AS "rows", count("id") AS "nn0", count(*) FILTER (WHERE coalesce(trim(CAST("id" AS VARCHAR)), '') = '') AS "blank0", count(DISTINCT "id") AS "distinct0", count("na""me") AS "nn1", count(*) FILTER (WHERE CAST("na""me" AS VARCHAR) <> trim(CAST("na""me" AS VARCHAR))) AS "edges1", list_sort(list(DISTINCT CAST("na""me" AS VARCHAR)) FILTER (WHERE "na""me" IS NOT NULL)) AS "values1" FROM (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1")"
`;

exports[`results table queries > profiles through SUMMARIZE 1`] = `
"SELECT column_name, CAST(null_percentage AS DOUBLE) AS null_pct, approx_unique, CAST(min AS VARCHAR) AS min, CAST(max AS VARCHAR) AS max FROM (SUMMARIZE SELECT * FROM (WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv')),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1"))"
`;

exports[`sample mode > reads only the first rows of a sampled source, and nothing else changes 1`] = `
"WITH "n_src" AS (SELECT * FROM read_csv('src_cust.csv') LIMIT 1000),
  "n_clean_s0" AS (SELECT * REPLACE (trim("name") AS "name") FROM "n_src"),
  "n_clean_s1" AS (SELECT * REPLACE (list_aggr(list_transform(string_split("name", ' '), w -> upper(left(w, 1)) || lower(substr(w, 2))), 'string_agg', ' ') AS "name") FROM "n_clean_s0")
SELECT * FROM "n_clean_s1""
`;

