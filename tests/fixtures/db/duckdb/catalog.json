      "sql": "CREATE VIEW order_totals AS SELECT c.\"name\", count(o.id) AS orders, sum(o.total) AS total FROM customers AS c LEFT JOIN orders AS o ON ((o.customer_id = c.id)) GROUP BY c.\"name\";"
