        "sql": "CREATE VIEW shop.order_totals (`name` String, `orders` UInt64, `total` Decimal(38, 2)) AS SELECT c.name, count(o.id) AS orders, sum(o.total) AS total FROM shop.customers AS c LEFT JOIN shop.orders AS o ON o.customer_id = c.id GROUP BY c.name"
