# Settings for compose.yaml. Copy this file to .env next to compose.yaml (`cp .env.example .env`), then fill it in.
# .env is gitignored: never commit it, and never put a real token in this template. See deploy/README.md.

# Which optional services `docker compose up -d` starts besides Puddle, comma separated: tunnel, runner, connect.
# With tunnel listed, cloudflared starts with Puddle. Leave it empty to run Puddle on its own.
COMPOSE_PROFILES=tunnel

# Cloudflare Tunnel: Zero Trust, then Networks, then Tunnels, then your tunnel, then the token in its install command
# (the long string after `--token`). Every node that serves puddle.kevspowertools.com uses this same token.
CLOUDFLARE_TUNNEL_TOKEN=

# The Puddle image. Leave unset to build from the Dockerfile; the published arm64 and amd64 image is
# ghcr.io/kevinmcaleer/puddle:latest (update it with `docker compose pull && docker compose up -d`).
PUDDLE_IMAGE=ghcr.io/kevinmcaleer/puddle:latest
# The port Puddle answers on, on the host (the tunnel does not need it).
#PUDDLE_PORT=8088
# The cloudflared image. Pin one of its release tags here to stop it moving under you.
#CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
# Set 0 to build where extensions.duckdb.org can't be reached.
#FETCH_EXTENSIONS=1

# Scheduled runs (the runner profile). Run it on one node only, or each schedule runs once per node.
#PUDDLE_RUNNER_IMAGE=puddle-run:latest
#PUDDLE_PROJECTS=/srv/puddle/projects
#PUDDLE_RUNNER_POLL=30
#PUDDLE_SECRETS_FILE=/srv/puddle/secrets.json
#TZ=Europe/London

# Databases on the Pi (the connect profile). The service refuses to start without a token.
#PUDDLE_CONNECT_IMAGE=puddle-connect:latest
#PUDDLE_CONNECT_TOKEN=
#PUDDLE_CONNECT_ALLOW=db.local,10.0.0.0/8
#PUDDLE_CONNECT_DATA=./data
#PUDDLE_CONNECT_TIMEOUT=60
#PUDDLE_CONNECT_ORIGIN=
