{
  "name": "puddle",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based data cleansing and preparation on DuckDB-WASM. Nothing leaves your browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:container": "playwright test -c playwright.container.config.ts",
    "fetch-extensions": "node scripts/fetch-duckdb-extensions.mjs public/duckdb-extensions"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@glideapps/glide-data-grid": "6.0.4-alpha24",
    "@radix-ui/react-slot": "^1.5.0",
    "@xyflow/react": "^12.12.0",
    "apache-arrow": "^17.0.0",
    "lucide-react": "^1.57.0",
    "markdown-it": "15.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "3.2"
  }
}
